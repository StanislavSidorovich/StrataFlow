{
  "format": "strata-flow",
  "version": 1,
  "name": "Library book loan",
  "participants": [
    {
      "id": "Participant_library",
      "name": "Library",
      "processId": "Process_loan"
    },
    {
      "id": "Participant_member",
      "name": "Member"
    }
  ],
  "lanes": [
    {
      "id": "Lane_desk",
      "name": "Front desk",
      "participantId": "Participant_library"
    },
    {
      "id": "Lane_stacks",
      "name": "Stacks",
      "participantId": "Participant_library"
    }
  ],
  "nodes": [
    {
      "id": "Start_requested",
      "name": "Loan requested",
      "participantId": "Participant_library",
      "laneId": "Lane_desk",
      "type": "event",
      "position": "start",
      "trigger": "message",
      "throwing": false
    },
    {
      "id": "Task_check",
      "name": "Check membership",
      "participantId": "Participant_library",
      "laneId": "Lane_desk",
      "type": "task",
      "kind": "task"
    },
    {
      "id": "Gateway_valid",
      "name": "Member valid?",
      "participantId": "Participant_library",
      "laneId": "Lane_desk",
      "type": "gateway",
      "kind": "exclusive",
      "defaultFlow": "Flow_yes"
    },
    {
      "id": "End_refused",
      "name": "Loan refused",
      "participantId": "Participant_library",
      "laneId": "Lane_desk",
      "type": "event",
      "position": "end",
      "trigger": "none",
      "throwing": true
    },
    {
      "id": "Task_fetch",
      "name": "Fetch book",
      "participantId": "Participant_library",
      "laneId": "Lane_stacks",
      "type": "task",
      "kind": "task"
    },
    {
      "id": "Task_lend",
      "name": "Lend book",
      "participantId": "Participant_library",
      "laneId": "Lane_desk",
      "type": "task",
      "kind": "task"
    },
    {
      "id": "Timer_due",
      "name": "Due date reached",
      "participantId": "Participant_library",
      "laneId": "Lane_desk",
      "type": "event",
      "position": "intermediate",
      "trigger": "timer",
      "throwing": false
    },
    {
      "id": "Task_remind",
      "name": "Send reminder",
      "participantId": "Participant_library",
      "laneId": "Lane_desk",
      "type": "task",
      "kind": "send"
    },
    {
      "id": "End_reminded",
      "name": "Reminder sent",
      "participantId": "Participant_library",
      "laneId": "Lane_desk",
      "type": "event",
      "position": "end",
      "trigger": "none",
      "throwing": true
    },
    {
      "id": "DataRef_slip",
      "name": "Loan slip",
      "participantId": "Participant_library",
      "laneId": "Lane_stacks",
      "type": "dataObject",
      "state": "filled"
    }
  ],
  "flows": [
    {
      "id": "Assoc_slip",
      "kind": "data",
      "source": "Task_fetch",
      "target": "DataRef_slip",
      "name": ""
    },
    {
      "id": "Flow_1",
      "kind": "sequence",
      "source": "Start_requested",
      "target": "Task_check",
      "name": ""
    },
    {
      "id": "Flow_2",
      "kind": "sequence",
      "source": "Task_check",
      "target": "Gateway_valid",
      "name": ""
    },
    {
      "id": "Flow_no",
      "kind": "sequence",
      "source": "Gateway_valid",
      "target": "End_refused",
      "name": "No",
      "condition": "membership expired"
    },
    {
      "id": "Flow_yes",
      "kind": "sequence",
      "source": "Gateway_valid",
      "target": "Task_fetch",
      "name": "Yes"
    },
    {
      "id": "Flow_3",
      "kind": "sequence",
      "source": "Task_fetch",
      "target": "Task_lend",
      "name": ""
    },
    {
      "id": "Flow_4",
      "kind": "sequence",
      "source": "Task_lend",
      "target": "Timer_due",
      "name": ""
    },
    {
      "id": "Flow_5",
      "kind": "sequence",
      "source": "Timer_due",
      "target": "Task_remind",
      "name": ""
    },
    {
      "id": "Flow_6",
      "kind": "sequence",
      "source": "Task_remind",
      "target": "End_reminded",
      "name": ""
    },
    {
      "id": "Msg_request",
      "kind": "message",
      "source": "Participant_member",
      "target": "Start_requested",
      "name": "Book request"
    },
    {
      "id": "Msg_reminder",
      "kind": "message",
      "source": "Task_remind",
      "target": "Participant_member",
      "name": "Reminder"
    }
  ],
