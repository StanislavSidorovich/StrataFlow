      "position": "intermediate",
      "trigger": "message",
      "throwing": false,
      "participantId": "Participant_1",
      "laneId": "Lane_2"
    },
    {
      "id": "Task_4",
      "name": "Check guest ID",
      "type": "task",
      "kind": "task",
      "participantId": "Participant_1",
      "laneId": "Lane_2"
    },
    {
      "id": "Task_5",
      "name": "Hand over key card",
      "type": "task",
      "kind": "task",
      "participantId": "Participant_1",
      "laneId": "Lane_2"
    },
    {
      "id": "Event_4",
      "name": "Guest checked in",
      "type": "event",
      "position": "end",
      "trigger": "none",
      "throwing": true,
      "participantId": "Participant_1",
      "laneId": "Lane_2"
    }
