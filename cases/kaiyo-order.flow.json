{
  "format": "strata-flow",
  "version": 1,
  "name": "Kaiyo Trading: distributor order",
  "participants": [
    {
      "id": "Participant_1",
      "name": "Kaiyo Trading",
      "processId": "Process_1"
    },
    {
      "id": "Participant_2",
      "name": "Distributor"
    }
  ],
  "lanes": [
    {
      "id": "Lane_1",
      "name": "Sales",
      "participantId": "Participant_1"
    },
    {
      "id": "Lane_2",
      "name": "Warehouse",
      "participantId": "Participant_1"
    },
    {
      "id": "Lane_3",
      "name": "Finance",
      "participantId": "Participant_1"
    }
  ],
  "nodes": [
    {
      "id": "Event_1",
      "name": "Order received",
      "type": "event",
      "position": "start",
      "trigger": "message",
      "throwing": false,
      "participantId": "Participant_1",
      "laneId": "Lane_1"
    },
    {
      "id": "Task_1",
      "name": "Post order in ERP",
      "type": "task",
      "kind": "user",
      "participantId": "Participant_1",
      "laneId": "Lane_1"
    },
    {
      "id": "Gateway_1",
      "name": "Stock available?",
      "type": "gateway",
      "kind": "exclusive",
      "participantId": "Participant_1",
      "laneId": "Lane_1",
      "defaultFlow": "Flow_4"
    },
    {
      "id": "Event_2",
      "name": "Order declined",
      "type": "event",
      "position": "end",
      "trigger": "message",
      "throwing": true,
      "participantId": "Participant_1",
      "laneId": "Lane_1"
    },
    {
      "id": "Gateway_2",
      "name": "",
      "type": "gateway",
      "kind": "parallel",
      "participantId": "Participant_1",
      "laneId": "Lane_1"
    },
    {
      "id": "Task_2",
      "name": "Pack goods",
      "type": "task",
      "kind": "manual",
      "participantId": "Participant_1",
      "laneId": "Lane_2"
    },
    {
      "id": "Task_3",
      "name": "Ship goods",
      "type": "task",
      "kind": "send",
      "participantId": "Participant_1",
      "laneId": "Lane_2"
    },
    {
      "id": "Task_4",
      "name": "Send invoice",
      "type": "task",
      "kind": "send",
      "participantId": "Participant_1",
      "laneId": "Lane_3"
    },
    {
      "id": "Gateway_3",
      "name": "",
      "type": "gateway",
      "kind": "parallel",
      "participantId": "Participant_1",
      "laneId": "Lane_3"
    },
    {
      "id": "Task_5",
      "name": "Receive payment",
      "type": "task",
      "kind": "receive",
      "participantId": "Participant_1",
      "laneId": "Lane_3"
    },
    {
      "id": "Event_3",
      "name": "Order paid",
      "type": "event",
      "position": "end",
      "trigger": "none",
      "throwing": true,
      "participantId": "Participant_1",
      "laneId": "Lane_3"
    },
    {
      "id": "Event_4",
      "name": "Payment overdue",
      "type": "event",
      "position": "boundary",
      "trigger": "timer",
      "throwing": false,
      "interrupting": false,
      "attachedTo": "Task_5",
      "participantId": "Participant_1",
      "laneId": "Lane_3"
    },
    {
      "id": "Event_5",
      "name": "Reminder sent",
      "type": "event",
      "position": "end",
      "trigger": "message",
      "throwing": true,
      "participantId": "Participant_1",
      "laneId": "Lane_3"
    },
    {
      "id": "DataStore_1",
      "name": "ERP",
      "type": "dataStore",
      "participantId": "Participant_1",
      "laneId": "Lane_1"
    },
    {
      "id": "Annotation_1",
      "name": "fact_sellin: order_date and amounts",
      "type": "annotation",
      "participantId": "Participant_1",
      "laneId": "Lane_1"
    },
    {
      "id": "Annotation_2",
      "name": "No row in fact_sellin: every row there was shipped",
      "type": "annotation",
      "participantId": "Participant_1",
      "laneId": "Lane_1"
    },
    {
      "id": "Annotation_3",
      "name": "The fact_sellin row is complete: ship_date, units, 2 to 11 days after the order",
      "type": "annotation",
      "participantId": "Participant_1",
      "laneId": "Lane_2"
    },
    {
      "id": "Annotation_4",
      "name": "Invoices and payments are not in the dataset",
      "type": "annotation",
      "participantId": "Participant_1",
      "laneId": "Lane_3"
    }
  ],
  "flows": [
    {
      "id": "Flow_1",
      "kind": "sequence",
      "source": "Event_1",
      "target": "Task_1",
      "name": ""
    },
    {
      "id": "Flow_2",
      "kind": "sequence",
