{
  "format": "strata-flow",
  "version": 1,
  "name": "Order fulfilment",
  "participants": [
    {
      "id": "Participant_1",
      "name": "Online shop",
      "processId": "Process_1"
    },
    {
      "id": "Participant_2",
      "name": "Customer"
    }
  ],
  "lanes": [
    {
      "id": "Lane_1",
      "name": "Sales",
      "participantId": "Participant_1"
    },
    {
      "id": "Lane_2",
      "name": "Warehouse",
      "participantId": "Participant_1"
    }
  ],
  "nodes": [
    {
      "id": "Event_1",
      "name": "Order received",
      "type": "event",
      "position": "start",
      "trigger": "message",
      "throwing": false,
      "participantId": "Participant_1",
      "laneId": "Lane_1"
    },
    {
      "id": "Task_1",
      "name": "Check stock",
      "type": "task",
      "kind": "user",
      "participantId": "Participant_1",
      "laneId": "Lane_1"
    },
    {
      "id": "Gateway_1",
      "name": "In stock?",
      "type": "gateway",
      "kind": "exclusive",
      "participantId": "Participant_1",
      "laneId": "Lane_1",
      "defaultFlow": "Flow_4"
    },
    {
      "id": "Event_2",
      "name": "Order rejected",
      "type": "event",
      "position": "end",
      "trigger": "message",
      "throwing": true,
      "participantId": "Participant_1",
      "laneId": "Lane_1"
    },
    {
      "id": "Gateway_2",
      "name": "",
      "type": "gateway",
      "kind": "parallel",
      "participantId": "Participant_1",
      "laneId": "Lane_1"
    },
    {
      "id": "Task_2",
      "name": "Pack goods",
      "type": "task",
      "kind": "manual",
      "participantId": "Participant_1",
      "laneId": "Lane_2"
    },
    {
      "id": "Task_3",
      "name": "Send invoice",
      "type": "task",
      "kind": "send",
      "participantId": "Participant_1",
      "laneId": "Lane_1"
    },
    {
      "id": "Gateway_3",
      "name": "",
      "type": "gateway",
      "kind": "parallel",
      "participantId": "Participant_1",
      "laneId": "Lane_2"
    },
    {
      "id": "Task_4",
      "name": "Receive payment",
      "type": "task",
      "kind": "receive",
      "participantId": "Participant_1",
      "laneId": "Lane_1"
    },
    {
      "id": "Task_5",
      "name": "Ship order",
      "type": "task",
      "kind": "manual",
      "participantId": "Participant_1",
      "laneId": "Lane_2"
    },
    {
      "id": "Event_3",
      "name": "Order shipped",
      "type": "event",
      "position": "end",
      "trigger": "none",
      "throwing": true,
      "participantId": "Participant_1",
      "laneId": "Lane_2"
    },
    {
      "id": "Event_4",
      "name": "14 days",
      "type": "event",
      "position": "boundary",
      "trigger": "timer",
      "throwing": false,
      "interrupting": false,
      "attachedTo": "Task_4",
      "participantId": "Participant_1",
      "laneId": "Lane_1"
    },
    {
      "id": "Event_5",
      "name": "Reminder sent",
      "type": "event",
      "position": "end",
      "trigger": "message",
      "throwing": true,
      "participantId": "Participant_1",
      "laneId": "Lane_1"
    },
    {
      "id": "DataObject_1",
      "name": "Packing slip",
      "type": "dataObject",
      "participantId": "Participant_1",
      "laneId": "Lane_2"
    }
